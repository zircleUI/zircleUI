{
  "name": "zircle",
  "version": "2.0.0-alpha.0",
  "description": "Zoomable user interface library built on Orbit (radial layout) and Zumly (zoom navigation). Vanilla JS, no framework.",
  "author": "Juan Martín Muda <juan.martin.muda@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/zircle.js",
  "module": "./dist/zircle.js",
  "exports": {
    ".": "./dist/zircle.js",
    "./style": "./dist/zircle.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@zumer/orbit": "^1.4.8",
    "zumly": "^0.92.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "zircle",
    "zui",
    "zoomable",
    "radial",
    "orbit",
    "zumly",
    "frontend",
    "library",
    "vanilla"
  ]
}
